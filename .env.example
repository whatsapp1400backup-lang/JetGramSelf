# کپی کن به .env و مقدار واقعی را بگذار — این فایل فقط نمونه است، هیچ مقدار واقعی ندارد
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# شماره تلگرام با کد کشور، مثل +989123456789 (اختیاری — اگر خالی باشد، موقع اجرا از تو می‌پرسد)
TELEGRAM_PHONE=
# رشته سشن (برای Railway) — بعد از اولین ورود روی کامپیوتر، با دستور زیر ساخته می‌شود (اختیاری)
TELEGRAM_SESSION_STRING=
